# Sao chép thành ".env" cạnh docker-compose.prod.yml rồi ĐỔI HẾT giá trị bên dưới.
# Tạo chuỗi ngẫu nhiên: dùng `openssl rand -hex 32`

DOMAIN=erp.dosco.vn
POSTGRES_PASSWORD=doi-mat-khau-db-that-manh
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-64-ky-tu
ATTENDANCE_API_KEY=doi-thanh-key-manh-cho-may-cham-cong

# Tùy chọn: bật bóc tách hóa đơn AI thật (mặc định "mock")
OCR_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=

# --- Đồng bộ TỰ ĐỘNG chấm công từ Yunatt (global.yunatt.com) ---
# Bật để backend tự đăng nhập Yunatt, kéo lượt quẹt mỗi ngày 20:00 và ghi vào ERP.
YUNATT_ENABLED=true
YUNATT_EMAIL=tai-khoan-yunatt@vi-du.com
YUNATT_PASSWORD=mat-khau-yunatt
YUNATT_SYNC_HOUR=20            # giờ chạy hằng ngày (20 = 8h tối)
# YUNATT_COMPANY_ID=0         # 0 = công ty đầu tiên (đổi nếu nhiều công ty)
# YUNATT_TIMEZONE=Asia/Ho_Chi_Minh
