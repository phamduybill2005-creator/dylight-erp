# === DYLIGHT ERP Backend - biến môi trường ===
# Sao chép file này thành .env và điền giá trị thật.

DATABASE_URL=postgresql+psycopg2://dylight:dylight@db:5432/dylight

# Đổi SECRET_KEY khi lên production (chuỗi ngẫu nhiên dài).
SECRET_KEY=doi-secret-key-nay-trong-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

FRONTEND_ORIGINS=http://localhost:3000

# --- AI OCR ---
# OCR_PROVIDER = mock | openai | google
#   mock   : chạy demo không cần API key (sinh dữ liệu mẫu).
#   openai : dùng GPT-4o Vision (điền OPENAI_API_KEY).
#   google : dùng Google Cloud Vision (điền GOOGLE_VISION_API_KEY).
OCR_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
GOOGLE_VISION_API_KEY=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# --- Zalo Official Account (chỉ backend, mặc định tắt) ---
ZALO_ENABLED=false
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_CALLBACK_URL=https://erp.dosco.vn/api/zalo/callback
ZALO_OA_ID=
ZALO_COMPANY_ID=0
# Chỉ bật gửi thông báo nhóm khi đã cấu hình GMF và OAuth; trống = bỏ qua.
ZALO_GMF_GROUP_ID=
# Nhắc đánh giá GMF ngày 27 lúc 08:00 giờ VN; chuẩn bị schema trước khi bật.
ZALO_EVAL_REMINDER_ENABLED=false
# Fernet key độc lập SECRET_KEY; xem docs/ZALO-OA-OAUTH-VPS.md.
ZALO_TOKEN_ENCRYPTION_KEY=
