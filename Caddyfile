# Reverse proxy + HTTPS tự động cho ERP.
# Một tên miền phục vụ cả web (Next.js) và API/ảnh (FastAPI) -> không lo CORS.
# Tên miền lấy từ biến DOMAIN trong .env (docker-compose.prod.yml truyền vào),
# mặc định erp.dosco.vn -> đổi domain chỉ cần sửa .env, KHÔNG phải sửa file này.
{$DOMAIN:erp.dosco.vn} {
	encode gzip

	# API và file tĩnh (ảnh hóa đơn) -> backend
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}

	# Còn lại -> frontend Next.js
	handle {
		reverse_proxy frontend:3000
	}
}
