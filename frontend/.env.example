# Biến môi trường cho FRONTEND.
# Khi deploy trên Vercel: vào Project Settings -> Environment Variables, thêm 2 biến này
# trỏ tới backend chạy trên Render (thay <ten-backend> bằng tên dịch vụ Render của bạn):
#
#   NEXT_PUBLIC_API_BASE   = https://<ten-backend>.onrender.com/api/v1
#   NEXT_PUBLIC_ASSET_BASE = https://<ten-backend>.onrender.com
#
# Lưu ý: Next.js "nướng" các biến NEXT_PUBLIC_* LÚC BUILD -> đặt biến TRƯỚC khi deploy/redeploy.
# Khi chạy ở máy local thì để trống cũng được (tự fallback về http://localhost:8000).

NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_ASSET_BASE=
